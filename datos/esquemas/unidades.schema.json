{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipn-comun/datos/esquemas/unidades.schema.json",
  "title": "Unidades académicas (SPDX-License-Identifier: CC0-1.0)",
  "type": "object",
  "required": ["version", "unidades"],
  "additionalProperties": false,
  "properties": {
    "_licencia": { "type": "string" },
    "_origen": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "unidades": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unidad" } }
  },
  "$defs": {
    "producto": {
      "type": "object",
      "required": ["disponible"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^[a-z0-9._/-]+$", "description": "Ruta relativa a la raíz del sitio, sin acentos" },
        "disponible": { "type": "boolean" }
      }
    },
    "unidad": {
      "type": "object",
      "required": ["id", "siglas", "nombre", "saes", "modelo", "productos"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
        "siglas": { "type": "string", "pattern": "^[A-ZÁÉÍÓÚÑ0-9]+$" },
        "nombre": { "type": "string", "minLength": 3 },
        "saes": { "type": "string", "format": "uri-absoluta", "pattern": "^https://" },
        "modelo": { "enum": ["semestral", "niveles"] },
        "productos": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "horarios": { "$ref": "#/$defs/producto" },
            "electivas": { "$ref": "#/$defs/producto" },
            "folio": {
              "type": "object",
              "required": ["plantillas"],
              "additionalProperties": false,
              "properties": {
                "plantillas": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
              }
            }
          }
        }
      }
    }
  }
}
