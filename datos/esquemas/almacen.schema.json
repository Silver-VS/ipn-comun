{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipn-comun/datos/esquemas/almacen.schema.json",
  "title": "Registro de prefijos de almacenamiento (SPDX-License-Identifier: CC0-1.0)",
  "type": "object",
  "required": ["version", "prefijos"],
  "additionalProperties": false,
  "properties": {
    "_licencia": { "type": "string" },
    "_nota": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "prefijos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["prefijo", "producto", "almacen", "sensible", "descripcion"],
        "additionalProperties": false,
        "properties": {
          "prefijo": { "type": "string", "pattern": "^[a-z]+\\.$" },
          "producto": { "enum": ["ipn-tools", "ipn-folio", "ipn-comun"] },
          "almacen": { "enum": ["localStorage", "sessionStorage", "indexedDB"] },
          "sensible": { "type": "boolean" },
          "descripcion": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
